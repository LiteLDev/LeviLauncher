{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:dev": "tsc --noEmit && vite build --minify false --mode development",
    "build": "tsc --noEmit && vite build --mode production && node ./scripts/check-bundle.mjs",
    "build:analyze": "tsc --noEmit && vite build --mode analyze && node ./scripts/check-bundle.mjs",
    "bundle:check": "node ./scripts/check-bundle.mjs",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@heroui/react": "^2.8.8",
    "@heroui/system": "2.4.27",
    "@microsoft/clarity": "^1.0.2",
    "@tailwindcss/vite": "^4.1.18",
    "@wailsio/runtime": "3.0.0-alpha.79",
    "framer-motion": "^12.26.1",
    "i18next": "^25.7.4",
    "i18next-browser-languagedetector": "^8.2.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.3",
    "react-aria-components": "^1.15.1",
    "react-dom": "^19.2.3",
    "react-i18next": "^16.5.2",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "7.18.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/typography": "^0.5.19",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "rollup-plugin-visualizer": "^6.0.5",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-checker": "^0.12.0"
  }
}
